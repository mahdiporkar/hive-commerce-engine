# Copy to deploy/.env. Real values live in the deployment's secret store, never in git.
ENGINE_IMAGE=ghcr.io/{{engineRepository}}:{{engineVersion}}
STORAGE_IMAGE=replace-with-pinned-s3-compatible-image@sha256:digest
COMMERCE_DB_PASSWORD=replace-me
COMMERCE_DB_OWNER_PASSWORD=replace-me
COMMERCE_STORAGE_ACCESS_KEY=replace-me
COMMERCE_STORAGE_SECRET_KEY=replace-me
COMMERCE_STORAGE_PUBLIC_ENDPOINT=https://files.{{domain}}
COMMERCE_JWT_ISSUER=https://id.{{domain}}/realms/{{storeKey}}
COMMERCE_JWT_JWKS_URI=https://id.{{domain}}/realms/{{storeKey}}/protocol/openid-connect/certs
# The object storage bucket {{storeKey}}-assets must exist; in production the engine does not create it.
# A real provider adapter. The engine ships only the fake one, and refuses to start with it in production.
COMMERCE_PAYMENT_PROVIDER=replace-me
HIVE_BFF_URL=http://bff:8080
STORE_HTTP_PORT=8080
