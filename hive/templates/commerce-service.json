{
  "target": {
    "key": "commerce-engine",
    "displayName": "Hive Commerce Engine",
    "baseUrl": "{{engineBaseUrl}}"
  },
  "route": {
    "key": "commerce",
    "applicationKey": "{{applicationKey}}",
    "pathPrefix": "/commerce",
    "targetKey": "commerce-engine",
    "authentication": "FORWARD_TOKEN"
  },
  "operations": [
    {
      "key": "admin-attribute-define",
      "method": "POST",
      "pathPattern": "/v1/admin/attributes",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.catalog",
      "action": "configure"
    },
    {
      "key": "admin-product-type-create",
      "method": "POST",
      "pathPattern": "/v1/admin/product-types",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.catalog",
      "action": "configure"
    },
    {
      "key": "admin-product-type-publish",
      "method": "POST",
      "pathPattern": "/v1/admin/product-types/{productTypeKey}/versions/{version}/publish",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.catalog",
      "action": "configure"
    },
    {
      "key": "admin-product-create",
      "method": "POST",
      "pathPattern": "/v1/admin/products",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.catalog",
      "action": "create"
    },
    {
      "key": "admin-product-get",
      "method": "GET",
      "pathPattern": "/v1/admin/products/{productId}",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.catalog",
      "action": "read"
    },
    {
      "key": "admin-category-create",
      "method": "POST",
      "pathPattern": "/v1/admin/categories",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.catalog",
      "action": "configure"
    },
    {
      "key": "admin-category-move",
      "method": "POST",
      "pathPattern": "/v1/admin/categories/{categoryId}/move",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.catalog",
      "action": "configure"
    },
    {
      "key": "admin-category-attributes",
      "method": "POST",
      "pathPattern": "/v1/admin/categories/{categoryId}/attributes",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.catalog",
      "action": "configure"
    },
    {
      "key": "admin-category-archive",
      "method": "POST",
      "pathPattern": "/v1/admin/categories/{categoryId}/archive",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.catalog",
      "action": "configure"
    },
    {
      "key": "admin-product-publish",
      "method": "POST",
      "pathPattern": "/v1/admin/products/{productId}/publish",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.catalog",
      "action": "publish"
    },
    {
      "key": "admin-listing-unpublish",
      "method": "POST",
      "pathPattern": "/v1/admin/listings/{listingId}/unpublish",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.catalog",
      "action": "publish"
    },
    {
      "key": "admin-listing-approve",
      "method": "POST",
      "pathPattern": "/v1/admin/listings/{listingId}/approve",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.moderation",
      "action": "decide"
    },
    {
      "key": "admin-listing-reject",
      "method": "POST",
      "pathPattern": "/v1/admin/listings/{listingId}/reject",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.moderation",
      "action": "decide"
    },
    {
      "key": "store-categories",
      "method": "GET",
      "pathPattern": "/v1/store/categories",
      "access": "PUBLIC"
    },
    {
      "key": "store-products-search",
      "method": "GET",
      "pathPattern": "/v1/store/products",
      "access": "PUBLIC"
    },
    {
      "key": "store-product-detail",
      "method": "GET",
      "pathPattern": "/v1/store/products/{slug}",
      "access": "PUBLIC"
    },
    {
      "key": "admin-offer-create",
      "method": "POST",
      "pathPattern": "/v1/admin/offers",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.catalog",
      "action": "update"
    },
    {
      "key": "admin-offer-stock",
      "method": "POST",
      "pathPattern": "/v1/admin/offers/{offerId}/stock",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.catalog",
      "action": "update"
    },
    {
      "key": "admin-orders",
      "method": "GET",
      "pathPattern": "/v1/admin/orders",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.orders",
      "action": "view"
    },
    {
      "key": "admin-order",
      "method": "GET",
      "pathPattern": "/v1/admin/orders/{orderId}",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.orders",
      "action": "view"
    },
    {
      "key": "admin-order-fulfillments",
      "method": "GET",
      "pathPattern": "/v1/admin/orders/{orderId}/fulfillments",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.orders",
      "action": "view"
    },
    {
      "key": "admin-fulfillment-ship",
      "method": "POST",
      "pathPattern": "/v1/admin/fulfillments/{fulfillmentId}/ship",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.orders",
      "action": "fulfill"
    },
    {
      "key": "admin-fulfillment-deliver",
      "method": "POST",
      "pathPattern": "/v1/admin/fulfillments/{fulfillmentId}/deliver",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.orders",
      "action": "fulfill"
    },
    {
      "key": "admin-order-refund",
      "method": "POST",
      "pathPattern": "/v1/admin/orders/{orderId}/refunds",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.orders",
      "action": "refund"
    },
    {
      "key": "shop-cart-create",
      "method": "POST",
      "pathPattern": "/v1/shop/carts",
      "access": "HYBRID"
    },
    {
      "key": "shop-cart",
      "method": "GET",
      "pathPattern": "/v1/shop/carts/current",
      "access": "HYBRID"
    },
    {
      "key": "shop-cart-add",
      "method": "POST",
      "pathPattern": "/v1/shop/carts/current/items",
      "access": "HYBRID"
    },
    {
      "key": "shop-cart-remove",
      "method": "DELETE",
      "pathPattern": "/v1/shop/carts/current/items/{itemId}",
      "access": "HYBRID"
    },
    {
      "key": "shop-checkout",
      "method": "POST",
      "pathPattern": "/v1/shop/checkouts",
      "access": "HYBRID"
    },
    {
      "key": "shop-checkout-get",
      "method": "GET",
      "pathPattern": "/v1/shop/checkouts/{checkoutId}",
      "access": "HYBRID"
    },
    {
      "key": "shop-orders",
      "method": "GET",
      "pathPattern": "/v1/shop/orders",
      "access": "HYBRID"
    },
    {
      "key": "shop-order",
      "method": "GET",
      "pathPattern": "/v1/shop/orders/{orderId}",
      "access": "HYBRID"
    },
    {
      "key": "shop-payment-verify",
      "method": "POST",
      "pathPattern": "/v1/shop/payments/{paymentId}/verify",
      "access": "HYBRID"
    },
    {
      "key": "admin-asset-create",
      "method": "POST",
      "pathPattern": "/v1/admin/assets",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.catalog",
      "action": "update"
    },
    {
      "key": "admin-asset-upload",
      "method": "POST",
      "pathPattern": "/v1/admin/assets/{assetId}/uploads",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.catalog",
      "action": "update"
    },
    {
      "key": "admin-asset-finalize",
      "method": "POST",
      "pathPattern": "/v1/admin/assets/{assetId}/uploads/{uploadId}/finalize",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.catalog",
      "action": "update"
    },
    {
      "key": "admin-asset-text",
      "method": "PUT",
      "pathPattern": "/v1/admin/assets/{assetId}/text",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.catalog",
      "action": "update"
    },
    {
      "key": "admin-asset-preview",
      "method": "PUT",
      "pathPattern": "/v1/admin/assets/{assetId}/preview",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.catalog",
      "action": "update"
    },
    {
      "key": "admin-entitlement-revoke",
      "method": "POST",
      "pathPattern": "/v1/admin/entitlements/{entitlementId}/revoke",
      "access": "AUTHENTICATED",
      "resourceKey": "commerce.api.digital",
      "action": "revoke"
    },
    {
      "key": "shop-library",
      "method": "GET",
      "pathPattern": "/v1/shop/library",
      "access": "HYBRID"
    },
    {
      "key": "shop-download",
      "method": "POST",
      "pathPattern": "/v1/shop/library/{entitlementId}/downloads",
      "access": "HYBRID"
    },
    {
      "key": "store-product-previews",
      "method": "GET",
      "pathPattern": "/v1/store/products/{productId}/previews",
      "access": "PUBLIC"
    }
  ]
}
