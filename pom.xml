<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Same Spring Boot line as the pinned Hive revision (ADR-0001, ADR-0002). -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.5</version>
    <relativePath/>
  </parent>

  <groupId>io.hivecommerce</groupId>
  <artifactId>hive-commerce-engine</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Hive Commerce Engine</name>

  <modules>
    <module>commerce-shared-kernel</module>
    <module>commerce-platform</module>
    <module>commerce-store</module>
    <module>commerce-catalog</module>
    <module>commerce-seller</module>
    <module>commerce-inventory</module>
    <module>commerce-pricing</module>
    <module>commerce-listing</module>
    <module>commerce-ordering</module>
    <module>commerce-payment</module>
    <module>commerce-fulfillment</module>
    <module>commerce-checkout</module>
    <module>commerce-digital-delivery</module>
    <module>commerce-finance</module>
    <module>commerce-app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Built from hive/HIVE_REVISION by tools/build-hive-starter.sh (ADR-0012). -->
    <hive.starter.version>0.1.0-a75871a</hive.starter.version>
    <archunit.version>1.4.1</archunit.version>
    <json-schema-validator.version>1.5.6</json-schema-validator.version>
    <springdoc.version>2.8.13</springdoc.version>
    <minio.version>8.5.17</minio.version>
    <!-- 1.21.3 (Boot 3.5.5 default) negotiates a Docker API version that Docker Engine 29 rejects; 1.21.4 fixes it. -->
    <testcontainers.version>1.21.4</testcontainers.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.hivecommerce</groupId>
        <artifactId>commerce-shared-kernel</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.hivecommerce</groupId>
        <artifactId>commerce-platform</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.hivecommerce</groupId>
        <artifactId>commerce-store</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.hivecommerce</groupId>
        <artifactId>commerce-catalog</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.hivecommerce</groupId>
        <artifactId>commerce-seller</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.hivecommerce</groupId>
        <artifactId>commerce-listing</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.hivecommerce</groupId>
        <artifactId>commerce-inventory</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.hivecommerce</groupId>
        <artifactId>commerce-pricing</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.hivecommerce</groupId>
        <artifactId>commerce-ordering</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.hivecommerce</groupId>
        <artifactId>commerce-payment</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.hivecommerce</groupId>
        <artifactId>commerce-fulfillment</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.hivecommerce</groupId>
        <artifactId>commerce-checkout</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.hivecommerce</groupId>
        <artifactId>commerce-digital-delivery</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.hivecommerce</groupId>
        <artifactId>commerce-finance</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.minio</groupId>
        <artifactId>minio</artifactId>
        <version>${minio.version}</version>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>io.hiveplatform</groupId>
        <artifactId>hive-spring-boot-starter</artifactId>
        <version>${hive.starter.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
